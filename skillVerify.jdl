// Entities for Recruitment Platform

enum ExamStatus {
  DRAFT, PUBLISHED, ARCHIVED
}

enum TestType {
  RECRUITMENT, PLACEMENT
}

enum ExerciseType {
  QCM, FILL_IN_THE_BLANK, BIND_LISTS, TRUE_FALSE, SHORT_ANSWER
}

enum MediaType {
  IMAGE, VIDEO, AUDIO, DOCUMENT
}

enum SubmissionStatus {
  NOT_STARTED, IN_PROGRESS, SUBMITTED, EVALUATED
}

// Recruiter
entity Recruiter {
  firstName String required
  lastName String required
  phone String
  bio TextBlob
  avatarUrl String
  company String required
  position String
  website String
  createdAt Instant
  updatedAt Instant
}

// Candidate
entity Candidate {
  firstName String required
  lastName String required
  phone String
  bio TextBlob
  avatarUrl String
  resumeUrl String
  linkedinUrl String
  githubUrl String
  yearsOfExperience Integer
  createdAt Instant
  updatedAt Instant
}

// Training Provider
entity TrainingProvider {
  firstName String required
  lastName String required
  phone String
  bio TextBlob
  avatarUrl String
  organizationName String required
  website String
  accreditation String
  createdAt Instant
  updatedAt Instant
}

// Exam
entity Exam {
  title String required
  description TextBlob
  duration Integer required // in minutes
  passingScore Integer required
  status ExamStatus required
  testType TestType required
  createdAt Instant
  updatedAt Instant
  publishedAt Instant
}

// Exercise
entity Exercise {
  type ExerciseType required
  title String required
  instruction TextBlob
  content TextBlob // question content
  explanation TextBlob
  points Integer required
  orderIndex Integer required
}

// Media attached to exercises
entity Media {
  type MediaType required
  s3Key String required
  s3Url String required
  fileName String required
  fileSize Long
  mimeType String
  uploadedAt Instant
}

// QCM Options (for QCM exercises)
entity QcmOption {
  content String required
  isCorrect Boolean required
  orderIndex Integer required
}

// Fill in the Blank (for FILL_IN_THE_BLANK exercises)
entity BlankSpace {
  position Integer required // position in text
  correctAnswer String required
  caseSensitive Boolean required
  orderIndex Integer required
}

// Bind Lists Items (for BIND_LISTS exercises)
entity ListItem {
  content String required
  matchingContent String required // the item it should match with
  isLeftSide Boolean required // true for left column, false for right
  orderIndex Integer required
}

// Exam Session (candidate taking exam)
entity ExamSession {
  startedAt Instant required
  submittedAt Instant
  status SubmissionStatus required
  score Integer
  totalPoints Integer
  timeSpent Integer // in seconds
}

// Candidate Answers
entity CandidateAnswer {
  answerText TextBlob // for SHORT_ANSWER, TRUE_FALSE
  isCorrect Boolean
  pointsAwarded Integer
  answeredAt Instant
}

// QCM Answer (selected options)
entity QcmAnswer {
  isCorrect Boolean
}

// Fill Blank Answer
entity BlankAnswer {
  answerText String required
  isCorrect Boolean
}

// Bind List Answer (matching pairs)
entity BindAnswer {
  leftItemId Long required
  rightItemId Long required
  isCorrect Boolean
}

// Relationships

relationship OneToOne {
  Recruiter{user(login) required} to User with builtInEntity
  Candidate{user(login) required} to User with builtInEntity
  TrainingProvider{user(login) required} to User with builtInEntity
}

relationship OneToMany {
  Recruiter{exams} to Exam{recruiter}
  TrainingProvider{exams} to Exam{trainingProvider}
  Exam{exercises} to Exercise{exam required}
  Exercise{media} to Media{exercise}
  Exercise{qcmOptions} to QcmOption{exercise required}
  Exercise{blankSpaces} to BlankSpace{exercise required}
  Exercise{listItems} to ListItem{exercise required}
  Candidate{examSessions} to ExamSession{candidate required}
  Exam{examSessions} to ExamSession{exam required}
  ExamSession{candidateAnswers} to CandidateAnswer{examSession required}
  Exercise{candidateAnswers} to CandidateAnswer{exercise required}
  CandidateAnswer{qcmAnswers} to QcmAnswer{candidateAnswer required}
  QcmOption{qcmAnswers} to QcmAnswer{qcmOption required}
  CandidateAnswer{blankAnswers} to BlankAnswer{candidateAnswer required}
  BlankSpace{blankAnswers} to BlankAnswer{blankSpace required}
  CandidateAnswer{bindAnswers} to BindAnswer{candidateAnswer required}
}

dto * with mapstruct
paginate * with pagination
service all with serviceImpl